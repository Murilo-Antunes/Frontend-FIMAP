# URL pública da API de autenticação (cadastro/login). Nunca coloque segredos em variáveis VITE_.
VITE_API_URL=http://localhost:3000

# API financeira (Open Finance) usada pelo dashboard
VITE_FINANCE_API_URL=http://localhost:8080/v1/openfinance

# Mostra bancos de teste (Sandbox) no widget de conexão. Deixe false em produção.
VITE_PLUGGY_INCLUDE_SANDBOX=true
